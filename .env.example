ENV=release
CARGO_BUILD_TARGET=x86_64-pc-windows-gnu

MASTER_PORT=5101
SLAVE_PORT=5201
SERVER_PORT=5301
WEB_PORT=5401

FRONTEND_URL=http://localhost:5401
BACKEND_URL=http://localhost:5301

LOG_LEVEL=info

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=nodero
MYSQL_USER=nodero_app
MYSQL_PASSWORD=nodero
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

DB_DSN=nodero_app:nodero@tcp(127.0.0.1:3306)/nodero?parseTime=true&charset=utf8mb4&loc=Local

GOOSE_DRIVER=mysql
GOOSE_DBSTRING=nodero_app:nodero@tcp(127.0.0.1:3306)/nodero?parseTime=true
GOOSE_MIGRATION_DIR=migrations

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
