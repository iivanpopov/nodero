{
  "name": "@nodero/plugin-svelte-query",
  "version": "0.1.0",
  "private": true,
  "description": "Local Kubb plugin for generating @tanstack/svelte-query v6 helpers and hooks.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external @kubb/ast --external @kubb/kit --external @kubb/plugin-ts --external @kubb/renderer-jsx && tsc -p ./tsconfig.build.json --emitDeclarationOnly",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kubb/ast": "5.27.0",
    "@kubb/kit": "5.27.0",
    "@kubb/plugin-ts": "^5.7.3",
    "@kubb/renderer-jsx": "5.27.0"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "^5.27.0",
    "@kubb/plugin-fetch": "^6.6.0",
    "@tanstack/svelte-query": "^6.4.7",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "kubb": "^5.27.0",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tanstack/svelte-query": "^6.0.0",
    "svelte": "^5.25.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/svelte-query": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
