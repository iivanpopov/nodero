{
  "format_on_save": "on",
  "languages": {
    "Svelte": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--no-script", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "...",
        "!vtsls",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "TypeScript": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["fmt", "--no-script", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "...",
        "!vtsls",
        "!typescript-language-server",
        "!stylelint-lsp",
        "!oxfmt",
        "!unocss-language-server",
        "!tailwindcss-language-server",
        "!oxlint",
        "!eslint"
      ]
    },
    "TSX": {
      "prettier": { "allowed": false },
